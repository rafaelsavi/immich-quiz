# Keep placeholders in committed files. Use your real values only in local .env.
IMMICH_SERVER_URL=https://your-immich-host.example.com
# IMMICH_LIBRARIES is a JSON object mapping library names to their API keys.
IMMICH_LIBRARIES={"family_library":"replace-with-api-key"}
# Base data directory where metadata.db and leaderboard.db are stored (default: data)
DATA_PATH=data
# Automatically trigger background metadata indexing on server startup (true/false)
AUTO_SYNC_ON_STARTUP=true
# Optional periodic sync interval in hours (0 disables)
AUTO_DELTA_SYNC_INTERVAL_HOURS=6
AUTO_FULL_SYNC_INTERVAL_HOURS=120
# Logging verbosity: DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO
# Page title and main heading shown on the landing page
APP_TITLE=Immich Quiz
# Optional tagline shown below the main heading on the landing page
APP_TAGLINE=Pass-and-play photo trivia powered by your private media libraries.
APP_HOST=127.0.0.1
APP_PORT=8010
# UI language: EN (English, default) or PT (Brazilian Portuguese)
LANGUAGE=EN

# Comma-separated list of allowed countries (empty = allow all available)
COUNTRY_WHITELIST=
# Comma-separated list of excluded countries
COUNTRY_BLACKLIST=

# Comma-separated list of allowed cities/regions (empty = allow all available)
CITY_WHITELIST=
# Comma-separated list of excluded cities/regions
CITY_BLACKLIST=

# Comma-separated list of allowed person names or IDs (empty = allow all named people)
PEOPLE_WHITELIST=
# Comma-separated list of excluded person names or IDs
PEOPLE_BLACKLIST=

# Comma-separated list of allowed asset tag names or IDs (empty = allow all tags)
TAG_WHITELIST=
# Comma-separated list of excluded asset tag names or IDs
TAG_BLACKLIST=

# Optional date bounds for photos eligible to be fetched into rounds (YYYY-MM-DD)
DATE_LOWER_BOUND=
DATE_UPPER_BOUND=