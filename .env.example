# Keep placeholders in committed files. Use your real values only in local .env.
IMMICH_SERVER_URL=https://your-immich-host.example.com/api
# IMMICH_LIBRARIES is a JSON object mapping library names to their API keys.
IMMICH_LIBRARIES={"family_library":"replace-with-api-key"}
# Path to the CSV file where the leaderboard is stored. Relative to the project root.
LEADERBOARD_CSV_PATH=data/leaderboard.csv
# Page title and main heading shown on the landing page
APP_TITLE=Immich Quiz
# Optional tagline shown below the main heading on the landing page
APP_TAGLINE=Pass-and-play photo trivia powered by your private media libraries.
# true = include shared albums by default in /api/albums when query param is omitted
INCLUDE_SHARED_ALBUMS=false
# Optional date bounds for photos eligible to be fetched into rounds (YYYY-MM-DD)
# Leave blank to disable a bound.
FETCH_PHOTOS_DATE_LOWER_BOUND=
FETCH_PHOTOS_DATE_UPPER_BOUND=
APP_HOST=127.0.0.1
APP_PORT=8010
# Max rendered image height in pixels (200-1600)
QUIZ_IMAGE_MAX_HEIGHT_PX=420
# Scoring parameters (all scores use exponential decay)
# Per-goal max points. Final per-turn max is this value per enabled goal.
SCORE_MAX_POINTS=100
# Location score uses: round(SCORE_MAX_POINTS * exp(-distance_km / LOCATION_SCORE_DECAY_KM))
LOCATION_SCORE_DECAY_KM=500
# Date score uses: round(SCORE_MAX_POINTS * exp(-delta_days / DATE_SCORE_DECAY_DAYS))
DATE_SCORE_DECAY_DAYS=500
# UI language: EN (English, default) or PT (Brazilian Portuguese)
LANGUAGE=EN
