# Keep placeholders in committed files. Use your real values only in local .env.
IMMICH_SERVER_URL=https://your-immich-host.example.com
# IMMICH_LIBRARIES is a JSON object mapping library names to their API keys.
IMMICH_LIBRARIES={"family_library":"replace-with-api-key"}
# Path to the CSV file where the leaderboard is stored. Relative to the project root.
LEADERBOARD_CSV_PATH=data/leaderboard.csv
# Path to SQLite metadata database for fast filters and candidate indexing
METADATA_DB_PATH=data/metadata.db
# Automatically trigger background metadata indexing on server startup (true/false)
AUTO_SYNC_ON_STARTUP=true
# Page title and main heading shown on the landing page
APP_TITLE=Immich Quiz
# Optional tagline shown below the main heading on the landing page
APP_TAGLINE=Pass-and-play photo trivia powered by your private media libraries.
APP_HOST=127.0.0.1
APP_PORT=8010
# Scoring parameters (all scores use exponential decay)
# Per-goal max points. Final per-turn max is this value per enabled goal.
SCORE_MAX_POINTS=100
# Location score uses: round(SCORE_MAX_POINTS * exp(-distance_km / LOCATION_SCORE_DECAY_KM))
LOCATION_SCORE_DECAY_KM=500
# Date score uses: round(SCORE_MAX_POINTS * exp(-delta_days / DATE_SCORE_DECAY_DAYS))
DATE_SCORE_DECAY_DAYS=500
# UI language: EN (English, default) or PT (Brazilian Portuguese)
LANGUAGE=EN
# Minimum distance (in km) and time separation (in seconds) between match photos
PHOTO_DIVERSITY_MIN_DISTANCE_KM=0.1
PHOTO_DIVERSITY_MIN_TIME_SECONDS=60.0
# Smart map auto-zoom parameters for Pinpoint mode
# Maximum initial zoom cap when framing match bounds (default: 6, ~500km regional view)
SMART_MAP_ZOOM_MAX_INITIAL_ZOOM=6
# Maximum distance span in km before falling back to global world view (default: 5000)
SMART_MAP_ZOOM_MAX_SPAN_KM=5000.0
# Comma-separated list of allowed countries (empty = allow all available)
COUNTRY_WHITELIST=
# Comma-separated list of excluded countries
COUNTRY_BLACKLIST=

# Comma-separated list of allowed cities/regions (empty = allow all available)
CITY_WHITELIST=
# Comma-separated list of excluded cities/regions
CITY_BLACKLIST=

# Comma-separated list of allowed person names (empty = allow all named people)
PEOPLE_WHITELIST=
# Comma-separated list of excluded person names
PEOPLE_BLACKLIST=

# Optional date bounds for photos eligible to be fetched into rounds (YYYY-MM-DD)
# Leave blank to disable a bound.
FETCH_PHOTOS_DATE_LOWER_BOUND=
FETCH_PHOTOS_DATE_UPPER_BOUND=