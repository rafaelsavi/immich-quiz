{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dev Dependencies",
      "type": "shell",
      "command": "uv sync --extra dev",
      "problemMatcher": []
    },
    {
      "label": "Run App",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "-m",
        "src.main"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run Pytest",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest"
      ],
      "problemMatcher": "$gcc",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run Pytest with Coverage",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest",
        "--cov=src",
        "--cov-report=term-missing"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "Lint & Format Code (Ruff)",
      "type": "shell",
      "command": "uv run ruff check --fix --unsafe-fixes . ; uv run ruff format .",
      "problemMatcher": []
    },
    {
      "label": "Type Check (Mypy)",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "mypy",
        "src"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run All CI Checks",
      "type": "shell",
      "command": "uv run ruff check . ; uv run mypy src ; uv run pytest --cov=src --cov-report=term-missing",
      "problemMatcher": []
    },
    {
      "label": "Docker Build",
      "type": "shell",
      "command": "docker",
      "args": [
        "build",
        "-t",
        "immich-quiz",
        "."
      ],
      "problemMatcher": []
    },
    {
      "label": "Docker Run",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-p",
        "8010:8010",
        "--env-file",
        ".env",
        "immich-quiz"
      ],
      "problemMatcher": []
    }
  ]
}